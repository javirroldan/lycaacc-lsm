# --- Cliente de la app (front, Vite) ---
# Estas variables se INCINSTRAN EN EL BUILD: ademas de .env.local, copialas
# tambien en el entorno de despliegue (Vercel/InsForge Sites) y redeploy.
VITE_INSFORGE_URL=https://TU-PROYECTO.insforge.app
VITE_INSFORGE_ANON_KEY=tu_anon_key

# --- Cuentas ocultas del login por codigo (front, Vite) ---
# Se incrustan en el build. Deben coincidir con las que crea scripts/setup-cuentas.mjs
# (lee los mismos valores desde .env.local) y estar presentes en el entorno de deploy.
VITE_ADMIN_EMAIL=admin@trenes.local
VITE_ADMIN_PASSWORD=cambiar-contrasena-admin
VITE_EMPLEADO_EMAIL=empleado@trenes.local
VITE_EMPLEADO_PASSWORD=cambiar-contrasena-empleado

# --- Solo para scripts locales (nunca en el front ni en git) ---
# .env.local
INSFORGE_URL=https://TU-PROYECTO.insforge.app
INSFORGE_API_KEY=ik_tu_api_key_admin
INSFORGE_ADMIN_PASSWORD=pass-del-admin